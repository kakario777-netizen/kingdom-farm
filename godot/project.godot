; 말랑 왕국 — 고도 프로젝트
config_version=5

[application]
config/name="말랑 왕국"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.75, 0.91, 1, 1)
boot_splash/show_image=false

[autoload]
D="*res://scripts/data.gd"
G="*res://scripts/game.gd"

[display]
window/size/viewport_width=832
window/size/viewport_height=384
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[input_devices]
pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[gui]
theme/custom_font="res://fonts/Jua-Regular.ttf"
theme/default_font_antialiasing=1
theme/default_font_hinting=0
common/drop_mouse_on_gui_input_disabled=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=2
anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0.75, 0.91, 1, 1)
